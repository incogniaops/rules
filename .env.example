# Untracked local configuration for the scripts and skills in ~/rules.
# Copy this file to .env, fill in the values and run: chmod 600 .env
# Credentials and sensitive data live here only, never in tracked files.

# Atlassian credentials for scripts/atlassian/ (the same API token works for Jira and Confluence)
JIRA_USER_EMAIL="replace_with_user_email"
JIRA_USER_TOKEN="replace_with_api_token"   # https://id.atlassian.com/manage-profile/security/api-tokens
CONFLUENCE_BASE="https://<site>.atlassian.net/wiki"

# Default mentions in /tio-readiness Confluence comments: "accountId|Name", comma-separated
TIO_READINESS_MENTIONS="712020:00000000-0000-0000-0000-000000000000|First Last"
